PORT=3001
STUB_MODE=true

# 0G Compute Router (OpenAI-compatible endpoint).
# Set ZG_ROUTER_BASE_URL to the network's router base URL.
ZG_ROUTER_BASE_URL=<0G_ROUTER_BASE_URL>
ZG_ROUTER_API_KEY=

# Chat model id as exposed by the router (see GET /v1/models).
ZG_CHAT_MODEL=qwen/qwen-2.5-7b-instruct

# Image generation strategy: mock | edit | generate
# - mock: return a bundled placeholder asset (no spend, no provider)
# - edit: async multipart submit + poll against /async/images/edits (testnet image-edit)
# - generate: sync POST /images/generations (mainnet text-to-image)
ZG_IMAGE_MODE=mock
ZG_IMAGE_MODEL=qwen/qwen-image-edit-2511
ZG_IMAGE_SIZE=1024x1024
ZG_IMAGE_VERIFY_TEE=true

# Path to the placeholder asset returned in mock mode and used as the seed
# image in edit mode. Defaults to assets/default-avatar.jpg.
ZG_IMAGE_MOCK_PATH=
ZG_IMAGE_SEED_PATH=

# Polling tuning for async image jobs (edit mode).
ZG_IMAGE_POLL_INTERVAL_MS=1500
ZG_IMAGE_POLL_TIMEOUT_MS=90000
