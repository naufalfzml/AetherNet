PORT=3001
STUB_MODE=true

# 0G Compute Router (OpenAI-compatible endpoint).
# Testnet example: https://router-api-testnet.integratenetwork.work/v1
# Mainnet: set to the production router base URL.
ZG_ROUTER_BASE_URL=
ZG_ROUTER_API_KEY=

# Chat model id as exposed by the router (see GET /v1/models).
ZG_CHAT_MODEL=qwen/qwen-2.5-7b-instruct
