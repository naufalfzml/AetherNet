PORT=3002

# 0G EVM RPC used to pay storage fees with the private key signer.
ZG_EVM_RPC=https://evmrpc-testnet.0g.ai

# 0G Storage indexer RPC. Testnet turbo endpoint:
# https://indexer-storage-testnet-turbo.0g.ai
# Mainnet: replace with the production indexer URL.
ZG_INDEXER_RPC=https://indexer-storage-testnet-turbo.0g.ai

# Wallet private key with OG balance to pay for upload gas.
ZG_STORAGE_PRIVATE_KEY=
